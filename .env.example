# Tiendanube MCP — Local development only
# Copy this file to .env for running the server locally (stdio / bun run dev).
#
# For remote deployments (e.g. Vercel), credentials are NOT stored on the server.
# Each user passes their own credentials via MCP client headers:
#   X-Tiendanube-Access-Token
#   X-Tiendanube-Store-Id
#   X-Tiendanube-Api-Base-Url (optional)

TIENDANUBE_ACCESS_TOKEN=your_access_token_here
TIENDANUBE_STORE_ID=your_store_id_here
TIENDANUBE_API_BASE_URL=https://api.tiendanube.com/v1
