# Tiendanube API Configuration
# Copy this file to .env and fill in your values

# Your Tiendanube access token (from your app's credentials)
TIENDANUBE_ACCESS_TOKEN=your_access_token_here

# Your store ID (from Tiendanube dashboard)
TIENDANUBE_STORE_ID=your_store_id_here

# API base URL (usually https://api.tiendanube.com/v1)
TIENDANUBE_API_BASE_URL=https://api.tiendanube.com/v1