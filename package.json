{
  "name": "mcp-tiendanube",
  "version": "0.1.0",
  "description": "An xmcp application with tool syntax",
  "scripts": {
    "build": "xmcp build && bun run postbuild",
    "postbuild": "node -e \"const fs=require('fs'); if(fs.existsSync('dist/http.js')) fs.renameSync('dist/http.js', 'dist/http.cjs')\"",
    "dev": "xmcp dev",
    "start": "node dist/http.cjs",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "bun test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "xmcp": "0.6.10",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "lefthook": "^2.1.8",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "ultracite": "7.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
