{
  "name": "mcp-tiendanube",
  "version": "0.1.1",
  "description": "An xmcp application with tool syntax",
  "scripts": {
    "prebuild": "node scripts/generate-home.mjs",
    "build": "xmcp build --vercel",
    "dev": "rm -rf dist && rm -rf .xmcp && xmcp dev",
    "start": "node dist/[transport].js",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "bun test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "xmcp": "0.6.10",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "lefthook": "^2.1.8",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "ultracite": "7.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
